            "size": 600,
            "text": "window._rlc.rlCustomJS(function () {\n\n    var isDesktop = window.matchMedia(\"(min-width: 768px)\");\n\n    const $scriptLoaderElm = document.getElementById('rlc-scripts');\n    if ($scriptLoaderElm) {\n        if ($scriptLoaderElm.classList.contains('rlc-loaded')) {\n            signature();\n        } else {\n            $scriptLoaderElm.addEventListener(\"SCRIPTS_LOADED\", signature);\n        }\n    }\n\n    function signature() {\n        gsap.registerPlugin(DrawSVGPlugin);\n        const sigWrap = document.querySelectorAll('.rlc-hassignature');\n        sigWrap.forEach(function ($element, index) {\n            drawSig($element);\n        });\n    }\n\n    function drawSig(el) {\n        const wrap = el,\n            container = wrap.querySelector('.rlc-drawsig'),\n            sig1 = container.querySelector('#Path-1'),\n            sig2 = container.querySelector('#Path-2'),\n            sig3 = container.querySelector('#Path-3'),\n            sig4 = container.querySelector('#Path-4')\n        ;\n\n        let tl = gsap.timeline({\n            defaults: {\n                ease: \"none\",\n                duration: 20\n            },\n            scrollTrigger: {\n                trigger: wrap,\n                start: \"top bottom\",\n                end: \"center center\",\n                scrub: 1\n            }\n        })\n        .to(container,5,{opacity: 1},0)\n        .fromTo(sig1,5,{drawSVG: \"0\"},{drawSVG:\"100%\"},0)\n        .fromTo(sig2,5,{drawSVG: \"0\"},{drawSVG:\"100%\"},5)\n        .fromTo(sig3,5,{drawSVG: \"0\"},{drawSVG:\"100%\"},10)\n        .fromTo(sig4,5,{drawSVG: \"0\"},{drawSVG:\"100%\"},15)\n        ;\n        tl.timeScale(2); \n        \n        \n    }\n\n\n    return;\n});"
