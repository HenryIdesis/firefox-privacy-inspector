rub: true,\n            invalidateOnRefresh: true,\n        },\n        opacity: 1\n    });\n\n    gsap.to(shopNav, {\n        scrollTrigger: {\n            trigger: menuExit,\n            start: () => \"top bottom\",\n            end: () => \"top 95%\",\n            scrub: true,\n            invalidateOnRefresh: true,\n        },\n        opacity: 0\n    });\n\n\n    window.addEventListener('load', () => {\n        ScrollTrigger.refresh();\n    });\n\n  } \n\n  return;\n\n});"
