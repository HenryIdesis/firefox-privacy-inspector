          "content": {
            "mimeType": "text/html; charset=UTF-8",
            "size": 7747,
            "text": "    <partial data-cgid=\"women-brand\">\n        \n\n\n\n\n\n\n\n\n\n\n\n<div class=\"js-menu-wrap menu-wrap\">\n<div class=\"js-nav-flyout-top level-2-3-top\">\n<div class=\"js-nav-flyout-title-content\">\n\n<span class=\"back-btn-label no-click\" data-cgid=\"women|brand\">Marcas</span>\n\n</div>\n</div>\n\n<!-- category id women-brand slot only flyout -->\n<div class=\"flyout-slot-content flyout-full-slot-content\">\n\n\n\n\n\n        \n\t \n\n\n\t\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<div class=\"open-html-content\">\n\n\n\n\n<div id=\"rlcid-08272026-eu-w-brand-flyout\" class=\"content-asset rlc-content\">\n\n\n\n\n\n\n\n\n\n\n\n\t\n\t\t\n\t\t\n\t\t\t<!-- 07102025-eu-w-brand-flyout COPY FROM NA -->\r\n<style type=\"text/css\">\r\n  @media screen and (min-width: 768px) {\r\n    .rlc-flyout#rlc-07102025-eu-w-brand-flyout.rlc-images_loaded--all {\r\n      background-image: url('https://www.ralphlauren.pt/on/demandware.static/-/Library-Sites-RalphLauren_EU_Library/default/dwae5fda82/img/202405/05232024-eu-brand-card-flyout/w_polo_brand_flyout_c01_bg.jpg');\r\n    }\r\n  }\r\n</style>\r\n<style type=\"text/css\">\r\n  .rlc-flyout#rlc-07102025-eu-w-brand-flyout .rlc-copygroup .rlc-logo {\r\n    width: 100%;\r\n  }\r\n  .rlc-flyout#rlc-07102025-eu-w-brand-flyout .rlc-copygroup {\r\n    width: 100%;\r\n    padding: 0 0.5em;\r\n  }\r\n  @media screen and (max-width: 959px) {\r\n    .rlc-flyout#rlc-07102025-eu-w-brand-flyout .rlc-copygroup {\r\n      padding: 0 0.2em;\r\n    }\r\n  }\r\n</style>\r\n  <!-- BEGIN FLYOUT TILE TEMPLATE - DO NOT CHANGE -->\r\n  \n\t\t\n\t\n\t\n\n\t\n\t\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\n\t\t\n\t\n\t\n\n\t\n\t\t\n\t\t\n\t\t\t\r\n  <!-- END FLYOUT TILE TEMPLATE -->\r\n