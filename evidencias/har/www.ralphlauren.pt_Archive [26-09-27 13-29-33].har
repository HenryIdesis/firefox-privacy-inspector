          "content": {
            "mimeType": "text/javascript",
            "size": 5129,
            "text": "window._rlc.rlCustomJS(function () {\n  // YOUR CODE HERE\n  const $scriptLoaderElm = document.getElementById('rlc-scripts');\n  let isDesktop = window.matchMedia(\"(min-width: 768px)\"),\n    mobile = false;\n    if (!isDesktop.matches) {\n        mobile = true;\n    }\n\n  if ($scriptLoaderElm) {\n    if ($scriptLoaderElm.classList.contains('rlc-loaded')) {\n      redesign26();\n    } else {\n      $scriptLoaderElm.addEventListener(\"SCRIPTS_LOADED\", redesign26);\n    }\n  }\n\n  \n\n  function redesign26() {\n\n\tconst content = document.getElementById('rl-content'),\n\t\theader = document.getElementsByTagName('header'),\n\t\ttnavHeight = document.getElementById('top-banner').offsetHeight,\n\t\ttickerHeight = document.querySelector('.header-banner-container').offsetHeight;\n\tlet topNavHeights = tnavHeight;\n\n\tcontent.style.setProperty('--rlc26-rlNavHeight', tnavHeight+'px');\n\tcontent.style.setProperty('--rlc26-tickerHeight', tickerHeight+'px');\n\n\tconst stickyNav = document.getElementById('rlc-stickynav');\n\n\tif (stickyNav) {\n\t\ttopNavHeights = tnavHeight + document.getElementById('rlc-stickynav').querySelector('.rlc-in').offsetHeight;\n\t}\n\tcontent.style.setProperty('--rlc26-topNavHeights', topNavHeights+'px');\n\n\n\n\tconst searchTrigger = document.querySelectorAll('.rlc-searchtrigger'),\n\t\tsiteSearch = document.querySelector('.search-icon');\n\n\tsearchTrigger.forEach(function ($element, index) {\n\t\t$element.addEventListener('click',function(e){\n\t\t\te.preventDefault();\n\t\t\tsiteSearch.click();\n\t\t});\n\t});\n\n\n\n\n\t// THE BELOW EFFECTS HAVE BEEN ABANDONED BY CREATIVE BUT LET'S HOLD ON TO THE CODE:\n\n\t//gsap.registerPlugin(ScrollTrigger);\n\n\tconst fadeCovers = content.querySelectorAll('.rlc-fadecover');\n\n\tfunction onClassChange(node, callback) {\n\t\tlet lastClassString = node.classList.toString();\n\n\t\tconst mutationObserver = new MutationObserver((mutationList) => {\n\t\t\tfor (const item of mutationList) {\n\t\t\t\tif (item.attributeName === \"class\") {\n\t\t\t\t\tconst classString = node.classList.toString();\n\t\t\t\t\tif (classString !== lastClassString) {\n\t\t\t\t\t\tcallback(mutationObserver);\n\t\t\t\t\t\tlastClassString = classString;\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t\tmutationObserver.observe(node, {\n\t\t\tattributes: true\n\t\t});\n\t\treturn mutationObserver;\n\t}\n\n\t// ENHANCED HERO\n\tconst enhancedHero = content.querySelectorAll('.rlc-hero-enhanced');\n\tenhancedHero.forEach(function ($element) {\n\t\tconst bg = $element.querySelector('.rlc-background');\n\t\tif (bg.classList.contains('rlc-hasvideo')) {\n\t\t\tif (bg.classList.contains('rlc-vidLoaded')) {\n\t\t\t\t$element.classList.add('rlc-ready');\n\t\t\t} else {\n\t\t\t\tbg.querySelector('.rlc-videocontainer').addEventListener(\"VIDEO_LOADED\",function(){\n\t\t\t\t\t$element.classList.add('rlc-ready');\n\t\t\t\t});\n\t\t\t}\n\t\t} else {\n\t\t\t$element.classList.add('rlc-ready');\n\t\t}\n\t});\n\n\t// EXPANDABLE TILE GRIDS\n\tconst expandables = document.querySelectorAll('.rlc-expandable');\n\n\texpandables.forEach(function ($expandable) {\n\t\tconst $inner = $expandable.querySelector('.rlc-in');\n\t\tconst $viewMore = $expandable.querySelector('.rlc-viewmore');\n\t\tconst $tiles = $inner.querySelectorAll('.rlc-tile');\n\t\tconst increment = parseInt($viewMore?.dataset.increment, 10) || 4;\n\n\t\tlet visibleCount = increment; // start by showing first 4 (or data-increment)\n\n\t\tfunction getTileBottom(index) {\n\t\t\t// Returns the bottom edge of the tile at `index` relative to rlc-in's top\n\t\t\tconst tile = $tiles[index];\n\t\t\tif (!tile) return 0;\n\t\t\tconst innerTop = $inner.getBoundingClientRect().top;\n\t\t\tconst tileBottom = tile.getBoundingClientRect().bottom;\n\t\t\treturn (tileBottom - innerTop) + $inner.scrollTop;\n\t\t}\n\n\t\t// Inject counter span after viewmore text (once, on init)\n\t\tconst $counter = document.createElement('span');\n\t\t$counter.classList.add('rlc-viewmore-counter');\n\t\t$viewMore.appendChild($counter);\n\n\t\t// Inject close button (hidden initially)\n\t\tconst $viewClose = document.createElement('button');\n\t\t$viewCloseSpan = document.createElement('span');\n\t\t$viewClose.classList.add('rlc-viewclose','rlc-button','rlc-pillbutton');\n\t\t$viewClose.style.display = 'none';\n\t\t$viewClose.appendChild($viewCloseSpan);\n\t\t$expandable.appendChild($viewClose);\n\n\t\tfunction setHeight() {\n\t\t\tconst lastVisible = Math.min(visibleCount, $tiles.length) - 1;\n\t\t\t$inner.style.height = getTileBottom(lastVisible) + 'px';\n\t\t\t$inner.style.overflow = 'hidden';\n\n\t\t\t// Update counter\n\t\t\t$counter.textContent = Math.min(visibleCount, $tiles.length) + ' / ' + $tiles.length;\n\n\t\t\t// Toggle buttons when all tiles are visible\n\t\t\tif (visibleCount >= $tiles.length) {\n\t\t\t\t$viewMore.style.display = 'none';\n\t\t\t\t$viewClose.style.display = '';\n\t\t\t} else {\n\t\t\t\t$viewMore.style.display = '';\n\t\t\t\t$viewClose.style.display = 'none';\n\t\t\t}\n\t\t}\n\n\t\tif (!$tiles.length || !$viewMore) return;\n\n\t\t// Set initial height after layout settles\n\t\trequestAnimationFrame(setHeight);\n\n\t\t$viewMore.addEventListener('click', function (e) {\n\t\t\te.preventDefault();\n\t\t\tvisibleCount += increment;\n\t\t\tsetHeight();\n\t\t});\n\n\t\t$viewClose.addEventListener('click', function (e) {\n\t\t\te.preventDefault();\n\t\t\tvisibleCount = increment;\n\t\t\tsetHeight();\n\t\t});\n\n\t\t// Recalculate on resize (tile reflow can change row heights)\n\t\twindow.addEventListener('resize', setHeight);\n\t});\n\n\t// PIN CLIPS \n\tconst pinClips = document.querySelectorAll(\".rlc-pinclip\");\n\tpinClips.forEach(function ($element, index) {\n\t\tvar rlcIn = $element.querySelector(\".rlc-pin\"),\n\t\t\tpar = $element.closest('.rlc-block');\n\t\tgsap.to($element,{scrollTrigger: {\n\t\t\ttrigger: $element,\n\t\t\tstart: \"top +=\"+topNavHeights+\"px\",\n\t\t\tend: \"bottom +=\"+topNavHeights+\"px\",\n\t\t\tinvalidateOnRefresh: true,\n\t\t\tonEnter: function () {\n\t\t\t\tenabled = true;\n\t\t\t},\n\t\t\ttoggleClass: {\n\t\t\t\ttargets: rlcIn,\n\t\t\t\tclassName: \"rlc-fixed\"\n\t\t\t}\n\t\t}});\n\t});\n\n\t// FADEOVERS\n\n\tconst fadeOvers = document.querySelectorAll(\".rlc-fadeover\");\n\tfadeOvers.forEach(function ($element, index) {\n\t\tgsap.to($element, {\n            scrollTrigger: {\n              trigger: $element,\n              start: () => \"top bottom\",\n              end: () => \"top 65%\",\n              scrub: 0.1\n            },\n            opacity: 1,\n            invalidateOnRefresh: true\n\t\t});\n\t});\n\n\tonClassChange(header[0], function() {\n\t\tScrollTrigger.refresh();\n\t});\n\n\t\n\t// LOOKBOOKS\n\n\tfunction spawnLookBook() {\n\t\tconst body = document.getElementsByTagName(\"body\")[0],\n\t\theader = body.getElementsByTagName(\"header\")[0],\n\t\tspawnButtons = document.querySelectorAll(\".rlc-spawnlookbook\"),\n\t\tqueryString = window.location.search,\n\t\turlParams = new URLSearchParams(queryString),\n\t\tstartOpen = urlParams.get(\"lookbook\"),\n\t\trw = document.querySelector(\".responsive-wrapper\");\n\t\tlet valModal = null,\n\t\tvalOverlay = null,\n\t\tabPrefix = null,\n\t\tvalScroll = null,\n\t\tvalOpen = false;\n\n\t\twindow.LOAD_IMAGE = new Event(\"LOAD_IMAGE\");\n\t\twindow.ENTER_VIEWPORT = new Event(\"ENTER_VIEWPORT\");\n\n\t\tfunction resized() {\n\t\tvar headerH = header.offsetHeight,\n\t\t\trwH = 0;\n\t\tif (rw != null) {\n\t\t\trwH = rw.offsetHeight;\n\t\t}\n\t\tdocument.documentElement.style.setProperty(\"--valNavPadding\", headerH + rwH + \"px\");\n\t\t}\n\t\twindow.onresize = resized;\n\t\tconst resizeObserver = new ResizeObserver(resized);\n\t\tresizeObserver.observe(body);\n\n\t\tfunction openModal() {\n\t\tdocument.body.classList.add(\"rlc-modalopen\");\n\t\tvar event = new CustomEvent(\"MODAL_OPEN\");\n\t\tdocument.body.dispatchEvent(event);\n\t\tvalOverlay.classList.add(\"rlc-open\");\n\t\tvalModal.classList.add(\"rlc-open\");\n\n\t\t// Make modal focusable and focus it for keyboard navigation\n\t\tvalScroll.setAttribute(\"tabindex\", \"-1\");\n\n\t\t// Ensure the scroll container is properly configured\n\t\tvalScroll.style.outline = \"none\"; // Remove focus outline\n\n\t\t// Small delay to ensure modal is rendered before focusing\n\t\tsetTimeout(() => {\n\t\t\tvalScroll.focus({ preventScroll: true });\n\t\t}, 100);\n\n\t\t// Prevent keyboard scrolling on background page\n\t\tdocument.addEventListener(\"keydown\", preventBackgroundScroll);\n\n\t\t// Redirect mouse wheel scrolling to modal\n\t\tdocument.addEventListener(\"wheel\", redirectWheelToModal, { passive: false });\n\n\t\tvar curr = 0;\n\t\t}\n\n\t\tfunction redirectWheelToModal(e) {\n\t\t// Check if the scroll is happening outside the modal\n\t\tconst isInModal = valModal && valModal.contains(e.target);\n\n\t\tif (!isInModal && valScroll) {\n\t\t\t// Prevent default page scroll\n\t\t\te.preventDefault();\n\n\t\t\t// Scroll the modal instead\n\t\t\tvalScroll.scrollTop += e.deltaY;\n\t\t}\n\t\t}\n\n\t\tfunction preventBackgroundScroll(e) {\n\t\t// Keys that cause scrolling: arrows, space, page up/down, home, end\n\t\tconst scrollKeys = [32, 33, 34, 35, 36, 37, 38, 39, 40];\n\n\t\tif (scrollKeys.includes(e.keyCode)) {\n\t\t\t// Check if the event target is within the modal\n\t\t\tconst isInModal = valModal && valModal.contains(e.target);\n\n\t\t\t// Only prevent if the target is not an input, textarea, or has contenteditable\n\t\t\tconst target = e.target;\n\t\t\tconst isInput =\n\t\t\ttarget.tagName === \"INPUT\" || target.tagName === \"TEXTAREA\" || target.isContentEditable;\n\n\t\t\t// If we're in the modal and not in an input, prevent default and scroll the modal\n\t\t\tif (isInModal && !isInput) {\n\t\t\te.preventDefault();\n\n\t\t\t// Manually scroll the modal content instead\n\t\t\tif (valScroll) {\n\t\t\t\tconst scrollAmount = 40; // pixels to scroll\n\t\t\t\tconst pageScrollAmount = valScroll.clientHeight * 0.8; // for page up/down\n\n\t\t\t\tswitch (e.keyCode) {\n\t\t\t\tcase 38: // up arrow\n\t\t\t\t\tvalScroll.scrollTop -= scrollAmount;\n\t\t\t\t\tbreak;\n\t\t\t\tcase 40: // down arrow\n\t\t\t\t\tvalScroll.scrollTop += scrollAmount;\n\t\t\t\t\tbreak;\n\t\t\t\tcase 33: // page up\n\t\t\t\t\tvalScroll.scrollTop -= pageScrollAmount;\n\t\t\t\t\tbreak;\n\t\t\t\tcase 34: // page down\n\t\t\t\tcase 32: // space\n\t\t\t\t\tvalScroll.scrollTop += pageScrollAmount;\n\t\t\t\t\tbreak;\n\t\t\t\tcase 36: // home\n\t\t\t\t\tvalScroll.scrollTop = 0;\n\t\t\t\t\tbreak;\n\t\t\t\tcase 35: // end\n\t\t\t\t\tvalScroll.scrollTop = valScroll.scrollHeight;\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t\t} else if (!isInModal && !isInput) {\n\t\t\t// Prevent scrolling the background page\n\t\t\te.preventDefault();\n\t\t\t}\n\t\t}\n\t\t}\n\n\t\tfunction closeModal() {\n\t\tdocument.body.classList.remove(\"rlc-modalopen\");\n\t\tvar event = new CustomEvent(\"MODAL_CLOSE\");\n\t\tdocument.body.dispatchEvent(event);\n\n\t\t// Remove keyboard scroll prevention\n\t\tdocument.removeEventListener(\"keydown\", preventBackgroundScroll);\n\n\t\t// Remove wheel scroll redirection\n\t\tdocument.removeEventListener(\"wheel\", redirectWheelToModal);\n\n\t\tvalModal.addEventListener(\"transitionend\", function (event) {\n\t\t\tvalModal.remove();\n\t\t\tvalOverlay.remove();\n\t\t});\n\n\t\tvalModal.classList.remove(\"rlc-open\");\n\t\tvalOverlay.classList.remove(\"rlc-open\");\n\n\t\t// s.pageName = \"\";\n\t\t// s.events = \"event300\";\n\t\t// s.linkTrackEvents = \"event300\";\n\t\t// s.linkTrackVars = \"events,eVar9,eVar11,eVar12,eVar15,eVar221,eVar222,eVar223,prop44\";\n\t\t// console.log(\"Closed modal\", s.events, s.linkTrackEvents, s.linkTrackVars);\n\t\t// s.prop44 = \"Spring/Summer 2026 Presentation closed\";\n\t\t// s.tl(this, \"o\", \"Spring/Summer 2026 Presentation closed\");\n\n\t\treturn false;\n\t\t}\n\n\t\tfunction spawnModal(page, abTag, open) {\n\t\tbody.style.cursor = \"wait\";\n\t\tvalOpen = open;\n\t\tvar xhr = new XMLHttpRequest();\n\t\txhr.open(\"GET\", page);\n\t\txhr.onload = function () {\n\t\t\tif (xhr.status === 200) {\n\t\t\tbody.style.cursor = \"auto\";\n\t\t\t// lbModalOpen = true;\n\t\t\tvalModal = document.createElement(\"div\");\n\t\t\tvalModal.setAttribute(\"id\", \"rlc-valmodal\");\n\n\t\t\tvalOverlay = document.createElement(\"div\");\n\t\t\tvalOverlay.setAttribute(\"id\", \"rlc-valoverlay\");\n\n\t\t\tvalModal.innerHTML = xhr.responseText;\n\t\t\tbody.appendChild(valOverlay);\n\t\t\tbody.appendChild(valModal);\n\n\t\t\t// Add mobile sticky header inside #rlc-valwrapper\n\t\t\tconst valWrapper = valModal.querySelector(\"#rlc-valwrapper\");\n\t\t\tlet mobileHeader;\n\t\t\tif (valWrapper) {\n\t\t\t\tmobileHeader = document.createElement(\"div\");\n\t\t\t\tmobileHeader.className = \"rlc-mobile-sticky-header\";\n\t\t\t\t// Get the title from modal\n\t\t\t\tconst modalTitle = valModal.querySelector(\".rlc-intro .rlc-title\");\n\t\t\t\tif (modalTitle) {\n\t\t\t\tmobileHeader.innerHTML = `<span class=\"rlc-title\">${modalTitle.textContent}</span>`;\n\t\t\t\t}\n\t\t\t\tvalWrapper.appendChild(mobileHeader);\n\t\t\t}\n\n\t\t\tconst valClose = valModal.querySelector(\".rlc-close\");\n\t\t\tvalScroll = valModal.querySelector(\".rlc-in\");\n\t\t\tvar valImage = valModal.querySelector(\".rlc-image\");\n\n\t\t\twindow._rlc.inView(valModal);\n\t\t\twindow._rlc.lazyLoader(valModal);\n\n\t\t\t// Mobile scroll logic for sticky header\n\t\t\tfunction showMobileHeaderOnScroll() {\n\t\t\t\tif (window.matchMedia(\"(max-width: 767px)\").matches) {\n\t\t\t\tconst introDek = valModal.querySelector(\".rlc-intro .rlc-dek\");\n\t\t\t\tif (!introDek) return;\n\t\t\t\tconst scrollContainer = valModal.querySelector(\".rlc-in\");\n\t\t\t\tif (!scrollContainer) return;\n\t\t\t\tconst mobileHeader = valModal.querySelector(\n\t\t\t\t\t\"#rlc-valwrapper .rlc-mobile-sticky-header\",\n\t\t\t\t);\n\t\t\t\tif (!mobileHeader) return;\n\t\t\t\tfunction checkHeaderVisibility() {\n\t\t\t\t\tconst dekRect = introDek.getBoundingClientRect();\n\t\t\t\t\tconst modalRect = valModal.getBoundingClientRect();\n\t\t\t\t\t// When bottom of .rlc-dek is at or above modal top\n\t\t\t\t\tif (dekRect.bottom <= modalRect.top) {\n\t\t\t\t\tmobileHeader.classList.add(\"rlc-slide-in\");\n\t\t\t\t\tvalModal.classList.add(\"rlc-header-visible\");\n\t\t\t\t\t} else {\n\t\t\t\t\tmobileHeader.classList.remove(\"rlc-slide-in\");\n\t\t\t\t\tvalModal.classList.remove(\"rlc-header-visible\");\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tscrollContainer.addEventListener(\"scroll\", checkHeaderVisibility);\n\t\t\t\twindow.addEventListener(\"resize\", checkHeaderVisibility);\n\t\t\t\t// Initial check\n\t\t\t\tcheckHeaderVisibility();\n\t\t\t\t}\n\t\t\t}\n\t\t\tshowMobileHeaderOnScroll();\n\n\t\t\tif (valImage.complete) {\n\t\t\t\topenModal();\n\t\t\t} else {\n\t\t\t\tvalImage.addEventListener(\"load\", () => {\n\t\t\t\topenModal();\n\t\t\t\t});\n\t\t\t}\n\n\t\t\tvalClose.addEventListener(\"click\", function (event) {\n\t\t\t\tcloseModal();\n\t\t\t});\n\n\t\t\tvalOverlay.addEventListener(\"click\", function (event) {\n\t\t\t\tcloseModal();\n\t\t\t});\n\n\t\t\tdocument.onkeydown = function (evt) {\n\t\t\t\tevt = evt || window.event;\n\t\t\t\tif (evt.keyCode == 27) {\n\t\t\t\tcloseModal();\n\t\t\t\t}\n\t\t\t};\n\n\t\t\t// s.pageName = digitalData.page.pageName;\n\t\t\t// s.events = \"event299\";\n\t\t\t// s.prop44 = \"Spring/Summer 2026 Presentation\";\n\t\t\t// s.linkTrackVars = \"events,prop44,eVar9,eVar11,eVar12,eVar15,eVar221,eVar222,eVar223\";\n\t\t\t// s.linkTrackEvents = \"event299\";\n\t\t\t// console.log(\"Opened modal\", s.events, s.linkTrackVars);\n\t\t\t// s.tl(this, \"o\", \"Spring/Summer 2026 Presentation Modal Open\");\n\t\t\t} else {\n\t\t\talert(\"Request failed.  Returned status of \" + xhr.status);\n\t\t\t}\n\t\t};\n\t\txhr.send();\n\t\t}\n\n\t\tfunction getParameterByName(name, page) {\n\t\tname = name.replace(/[\\[\\]]/g, \"\\\\$&\");\n\t\tvar regex = new RegExp(\"[?&]\" + name + \"(=([^&#]*)|&|#|$)\"),\n\t\t\tresults = regex.exec(page);\n\t\tif (!results) return null;\n\t\tif (!results[2]) return \"\";\n\t\treturn decodeURIComponent(results[2].replace(/\\+/g, \" \"));\n\t\t}\n\n\t\tspawnButtons.forEach(function ($element, index) {\n\t\t$element.addEventListener(\"click\", function (event) {\n\t\t\tevent.preventDefault();\n\t\t\tconst page = $element.dataset.content;\n\t\t\tlet link = $element.getAttribute(\"href\").toString(),\n\t\t\tab = getParameterByName(\"ab\", link);\n\t\t\tabPrefix = null;\n\t\t\tif (ab != null) {\n\t\t\tlet abRegex = /^(.*?)Slot/,\n\t\t\t\tx = ab.match(abRegex);\n\t\t\tabPrefix = x[1].toString();\n\t\t\t}\n\t\t\tspawnModal(page, abPrefix, false);\n\t\t\treturn false;\n\t\t});\n\t\t});\n\n\t\tif (startOpen == \"true\") {\n\t\tspawnModal(spawnButtons[0].dataset.content, null, true);\n\t\t}\n\t}\n\tif (document.querySelector('.rlc-spawnlookbook')) {\n\t\tspawnLookBook();\n\t}\n\n\t// FIT GUIDES\n\n\tconst fitguides = content.querySelectorAll('.rlc-fitguide');\n\tfitguides.forEach(function ($element, index) {\n\t\tconst controller = $element.querySelector('.rlc-controller'),\n\t\t\tcontrolLinks = controller.querySelectorAll('.rlc-link'),\n\t\t\tguides = $element.querySelectorAll('.rlc-carousel');\n\n\n\t\tcontrolLinks[0].classList.add('rlc-active');\n\t\tguides[0].classList.add('rlc-active');\n\n\t\tcontrolLinks.forEach(function ($this, index) {\n\t\t\t$this.addEventListener(\"click\", function(e){\n\t\t\t\te.preventDefault();\n\t\t\t\tcontrolLinks.forEach(function ($link, index) {\n\t\t\t\t\t$link.classList.remove('rlc-active');\n\t\t\t\t});\n\t\t\t\t$this.classList.add('rlc-active');\n\t\t\t\tguides.forEach(function ($guide, index) {\n\t\t\t\t\t$guide.classList.remove('rlc-active');\n\t\t\t\t});\n\t\t\t\tguides[index].classList.add('rlc-active');\n\t\t\t\treturn false;\n\t\t\t});\n\t\t});\n\t});\n\t\n\n  } \n\n  return;\n\n});"
          },
