);\n} else if (pageName.indexOf(':be-fr:') >= 0) {\npageName = pageName.replace(':be-fr:', ':');\n} else if (pageName.indexOf(':fr-fr:') >= 0) {\npageName = pageName.replace(':fr-fr:', ':');\n} else if (pageName.indexOf(':ie-en:') >= 0) {\npageName = pageName.replace(':ie-en:', ':');\n} else if (pageName.indexOf(':it-it:') >= 0) {\npageName = pageName.replace(':it-it:', ':');\n} else if (pageName.indexOf(':lu-fr:') >= 0) {\npageName = pageName.replace(':lu-fr:', ':');\n} else if (pageName.indexOf(':pt-pt:') >= 0) {\npageName = pageName.replace(':pt-pt:', ':');\n} else if (pageName.indexOf(':es-es:') >= 0) {\npageName = pageName.replace(':es-es:', ':');\n} else if (pageName.indexOf(':nl-en:') >= 0) {\npageName = pageName.replace(':nl-en:', ':');\n}\n//Clear pageName for sandboxes\nif (pageName.indexOf(':on:demandware.store') === 0) {\npageName = pageName.replace(':on:demandware.store', '');\n}\nreturn pageName;\n}\ninit();\n</script>\n<input type=\"hidden\" class=\"page-Name-dublicate\" value=\"pt_PT:dlp:World of RL Fall:world of rl fall feat\"/>\n<input type=\"hidden\" class=\"user-data-LoginState\" value=\"guest\"/>\n<input type=\"hidden\" class=\"user-data-country\" value=\"\"/>\n<input type=\"hidden\" class=\"user-data-Gender\" value=\"\"/>\n<input type=\"hidden\" class=\"user-data-State\" value=\"null\"/>\n<input type=\"hidden\" class=\"user-data-UserID\" value=\"\"/>\n<input type=\"hidden\" class=\"user-data-DWID\" value=\"\"/>\n<input type=\"hidden\" class=\"user-data-SessionID\" value=\"udxu1Xjjf8Qw5FsYLkk6_GSF28tt_hRhTM8=\"/>\n\n\n\n\n\n\n\n\n\n<script src=\"/on/demandware.static/Sites-RLEU_Sterling-Site/-/pt_PT/v1790497671745/lib/library-bundle.js\" type=\"text/javascript\"></script>\n<script type=\"text/javascript\">\n\n(function(){\nwindow.stateCityMap = '';\nwindow.Constants = {\"AVAIL_STATUS_IN_STOCK\":\"IN_STOCK\",\"AVAIL_STATUS_PREORDER\":\"PREORDER\",\"AVAIL_STATUS_BACKORDER\":\"BACKORDER\",\"AVAIL_STATUS_NOT_AVAILABLE\":\"NOT_AVAILABLE\"};\nwindow.Resources = {\"I_AGREE\":\"Concordo\",\"CLOSE\":\"Fechar\",\"NO_THANKS\":\"Não, obrigado\",\"OK\":\"OK\",\"SUNDAY\":\"Domingo\",\"MONDAY\":\"Segunda-feira\",\"TUESDAY\":\"Terça-feira\",\"WEDNESDAY\":\"Quarta-feira\",\"THURSDAY\":\"Quinta-feira\",\"FRIDAY\":\"Sexta-feira\",\"SATURDAY\":\"Sábado\",\"JANUARY\":\"Janeiro\",\"FEBRUARY\":\"Fevereiro\",\"MARCH\":\"Março\",\"APRIL\":\"Abril\",\"MAY\":\"Maio\",\"JUNE\":\"Junho\",\"JULY\":\"Julho\",\"AUGUST\":\"Agosto\",\"SEPTEMBER\":\"Setembro\",\"OCTOBER\":\"Outubro\",\"NOVEMBER\":\"Novembro\",\"DECEMBER\":\"Dezembro\",\"SHIP_QualifiesFor\":\"Esta entrega reúne os requisitos necessários para\",\"CC_LOAD_ERROR\":\"Não foi possível carregar o cartão de crédito.\",\"COULD_NOT_SAVE_ADDRESS\":\"Não foi possível guardar o endereço. Verifique as entradas e tente novamente.\",\"STEP_TOOLTIP_MESSAGE\":\"Clique em continuar para guardar as atualizações.\",\"OPENINVOICE_GERMANY\":\"Lamentamos, mas não foi possível efetuar a sua encomenda. O método de pagamento selecionado só está disponível com um endereço de faturação na Alemanha. Utilize um endereço de faturação alemão ou selecione outro método de pagamento e efetue a encomenda novamente.\",\"CONTINUE_REVIEW\":\"Continuar para Revisão\",\"CONTINUE_REVIEW_KLARNA\":\"PAGAR COM A KLARNA\",\"CONTINUE_REVIEW_IDEAL\":\"CONTINUAR COM IDEAL\",\"PLACE_ORDER\":\"Comprar agora\",\"CONTINUE_PAYPAL\":\"Continuar para PayPal\",\"MIN_LENGTH_CHECKOUT_ERROR\":\"Introduza um número de telefone com pelo menos 10 dígitos \",\"SECURITY_TITLE\":\"Garantia de compra segura\",\"SECURITY_CONTENTONE\":\"Utilizamos o protocolo de encriptação padrão do setor conhecido como Secure Socket Layer (SSL) para manter as informações relativas à sua encomenda seguras.\",\"SECURITY_CONTENTTWO\":\"Implementámos uma Garantia de compra segura para todas as transações que efetuar em www.RalphLauren.co.uk. No caso de aparecerem despesas não autorizadas no seu cartão de crédito como resultado de compras efetuadas em www.RalphL