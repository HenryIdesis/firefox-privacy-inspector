          "content": {
            "mimeType": "text/javascript",
            "size": 3105,
            "text": "window._rlc.rlCustomJS(function () {\n  // YOUR CODE HERE\n  const $scriptLoaderElm = document.getElementById('rlc-scripts');\n  let isDesktop = window.matchMedia(\"(min-width: 768px)\"),\n    mobile = false;\n    if (!isDesktop.matches) {\n        mobile = true;\n    }\n\n    const isSafari = navigator.vendor && \n                 navigator.vendor.indexOf('Apple') > -1 &&\n                 navigator.userAgent &&\n                 navigator.userAgent.indexOf('CryptoSafari') === -1 && // Optional safeguards\n                 navigator.userAgent.indexOf('CriOS') === -1 &&\n                 navigator.userAgent.indexOf('FxiOS') === -1;\n\n\n    if (isSafari) {\n        document.documentElement.classList.add('is-safari');\n    }\n\n  if ($scriptLoaderElm) {\n    if ($scriptLoaderElm.classList.contains('rlc-loaded')) {\n      redesign26();\n    } else {\n      $scriptLoaderElm.addEventListener(\"SCRIPTS_LOADED\", goldStar);\n    }\n  }\n\n  \n\n  function goldStar() {\n\n    ScrollTrigger.config({ ignoreMobileResize: true });\n    //if (mobile) {\n        ScrollTrigger.normalizeScroll({\n            ignore: \"#top-banner, #top-banner *,#rlc-jumpnav,#rlc-jumpnav *\"\n        });\n    //}\n    \n\n    const content = document.getElementById('rl-content'),\n        gStar = content.querySelector('.rlc-goldstar'),\n        heroVid = document.getElementById('rlc-hero').querySelector('.rlc-videocontainer');\n\n    document.documentElement.style.setProperty('--rlc26-rlNavHeight', document.getElementById('top-banner').offsetHeight+'px');\n\n    setTimeout(function() {\n        gStar.classList.add('rlc-ready');\n    },1000);\n\n\n    // CURTAIN SECTIONS\n    const curtains = content.querySelectorAll('.rlc-curtains');\n    curtains.forEach(function ($element, index) {\n        const el = $element,\n          elIn = el.querySelector('.rlc-in'),\n          bg =  el.querySelector('.rlc-bgvid'),\n          bgCopyWrap = bg.querySelector('.rlc-copywrap'),\n          bgCopy = bg.querySelector('.rlc-copygroup'),\n          curtain = el.querySelectorAll('.rlc-curtain'),\n          tile = el.querySelectorAll('.rlc-tile'),\n          bgImg = el.querySelector('.rlc-background .rlc-image');\n        let holdVh = 1,\n        curtainSpeed = 2.25,\n        introZoom = 1.5;\n\n        if (mobile) {\n            introZoom = 1.25\n        }\n\n          gsap.set(bgCopy, { opacity: 0 });\n\n          if (!mobile) {\n\n            let intro = gsap.timeline({\n                defaults: {\n                    ease: \"none\",\n                    duration: 2\n                },\n                scrollTrigger: {\n                    trigger: bg,\n                    start: () => \"top 40%\",\n                    end: () => \"top 5%\",\n                    scrub: true,\n                    invalidateOnRefresh: true\n                }\n            })\n            .fromTo(bgCopy,1,{opacity: 0, xPercent: -50, yPercent: -50, scale: introZoom},{opacity: 1, xPercent: -50, yPercent: -50, scale: 1},0);\n\n            gsap.set(tile, { autoAlpha: 0 });\n\n            let tl = gsap.timeline({\n                defaults: {\n                    ease: \"none\"\n                },\n                scrollTrigger: {\n                    trigger: el,\n                    start: () => \"top top\",\n                    end: () => \"+=\" + (curtainSpeed * (elIn.offsetHeight + (window.innerHeight * holdVh))),\n                    endTrigger: elIn,\n                    pin: el,\n                    anticipatePin: 1,\n                    pinSpacing: true,\n                    scrub: true,\n                    fastScrollEnd: true,\n                    invalidateOnRefresh: true\n                }\n            })\n            .to(bgCopyWrap,0.25,{yPercent: -100, opacity: 0},0)\n\n            // FIRST CURTAIN\n            .to([tile[0],tile[1],tile[2]],0,{autoAlpha: 1},0)\n            .fromTo([tile[0],tile[2]], 0.25, { width: 0 }, { width: '30em' }, 0)\n            .fromTo(tile[1].querySelector('.rlc-copygroup'), 0.25, { opacity: 0,yPercent: 200 }, { opacity: 1,yPercent: -50 }, 0)\n            .to([tile[0],tile[1]],0.25,{autoAlpha: 0},0.5)\n\n            // SECOND CURTAIN\n            .fromTo(tile[1].querySelector('.rlc-copygroup'), 0.25, { opacity: 1,yPercent: -50 }, { opacity: 0,yPercent: -250 }, 0.5)\n            .to([tile[3],tile[4]],0.25,{autoAlpha: 1},0.5)\n            .fromTo(tile[4].querySelector('.rlc-copygroup'), 0.25, { opacity: 0,yPercent: 200 }, { opacity: 1,yPercent: -50 }, 0.5)\n            .to(tile[2],0.25,{autoAlpha: 0},1)\n            .to(tile[5],0.25,{autoAlpha: 1},1)\n            .fromTo(tile[4].querySelector('.rlc-copygroup'), 0.25, { opacity: 1,yPercent: -50 }, { opacity: 0,yPercent: -250 }, 1.5)\n\n            // THIRD CURTAIN\n            .to([tile[6],tile[7]],0.25,{autoAlpha: 1},1.5)\n            .fromTo(tile[7].querySelector('.rlc-copygroup'), 0.25, { opacity: 0,yPercent: 200 }, { opacity: 1,yPercent: -50 }, 1.5)\n            .to(tile[5],0.25,{autoAlpha: 0},2)\n            .to(tile[8],0.25,{autoAlpha: 1},2)\n            .fromTo(tile[7].querySelector('.rlc-copygroup'), 0.25, { opacity: 1,yPercent: -50 }, { opacity: 0,yPercent: -250 }, 2.5)\n            .to([tile[6],tile[8]], 0.25, { width: 0 }, 2.5)\n            .fromTo(tile[7], 0.25, { clipPath: 'polygon(33.33% 0, 66.66% 0%, 66.66% 100%, 33.33% 100%)'},{ clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)'}, 2.5)\n            .fromTo(bgImg,0.25,{scale: 1.5,xPercent: -50},{scale: 1,xPercent: -50}, 2.5)\n            .to(elIn,0.25,{autoAlpha: 0}, 2.5)\n            .to({}, { duration: 1 });\n            ;\n          } else {\n\n            let intro = gsap.timeline({\n                defaults: {\n                    ease: \"none\",\n                    duration: 2\n                },\n                scrollTrigger: {\n                    trigger: bg,\n                    start: () => \"top 60%\",\n                    end: () => \"top 15%\",\n                    scrub: true,\n                    invalidateOnRefresh: true\n                }\n            })\n            .fromTo(bgCopy,1,{opacity: 0, xPercent: -50, yPercent: -50, scale: introZoom},{opacity: 1, xPercent: -50, yPercent: -50, scale: 1},0);\n\n            holdVh = 5;\n            curtainSpeed = 1;\n            tl = gsap.timeline({\n                defaults: {\n                    ease: \"none\",\n                    duration: 1\n                },\n                scrollTrigger: {\n                    trigger: elIn,\n                    start: () => \"top top\",\n                    end: () => \"+=\" + (curtainSpeed * (2*(elIn.offsetHeight + (window.innerHeight * holdVh)))),\n                    pin: el,\n                    scrub: true,\n                    fastScrollEnd: true,\n                    invalidateOnRefresh: true\n                }\n            })\n            .to(bgCopyWrap,0.12,{xPercent: -200, opacity: 0},0)\n            \n            // FIRST CURTAIN\n            .to(curtain[0],0.25,{x: '-300vw'},0)\n\n            // SECOND CURTAIN\n            .fromTo(curtain[1],0.25,{yPercent: 100},{yPercent: 0},0.25)\n            .to(curtain[1],0.25,{x: '-200vw'},0.5)\n\n            // THIRD CURTAIN\n            .fromTo(curtain[2],0.25,{yPercent: 100},{yPercent: 0},0.75)\n            .to(curtain[2],0.25,{x: '-200vw'},1)\n            ;\n          }\n    });\n\n    // TILE DRIFTS\n    const tileDrifts = content.querySelectorAll('.rlc-tiledrift');\n    tileDrifts.forEach(function ($element, index) {\n        bgVid = $element.querySelector('.rlc-bgvid').querySelector('.rlc-videocontainer'),\n        deks = $element.querySelectorAll('.rlc-dek');\n      let dirS = 0,\n        dirF = -25;\n      if (index == 1) {\n        dirS = 25,\n        dirF = 50;\n      }\n      let tiles = $element.querySelector('.rlc-tiles');\n      gsap.set(deks, { autoAlpha: 0 });\n      gsap.set(deks[0], { autoAlpha: 1 });\n      if (!mobile) {\n        let tD = gsap.timeline({\n              defaults: {\n                  ease: \"none\",\n                  duration: 1\n              },\n              scrollTrigger: {\n                  trigger: $element,\n                  start: () => \"top top\",\n                  pin: true,\n                  scrub: 0.1,\n                  anticipatePin: 1,\n                  pinSpacing: true,\n                  invalidateOnRefresh: true\n              }\n          })\n          .fromTo(tiles,1,{y: 0},{y: '-200dvh'},0)\n          .fromTo(bgVid,1,{xPercent: dirS},{xPercent: dirF},0)\n          .fromTo(deks[0],0.08,{yPercent: -50, autoAlpha: 1},{yPercent: -250, autoAlpha: 0},0.25)\n          .fromTo(deks[1],0.08,{yPercent: 200, autoAlpha: 0},{yPercent: -50, autoAlpha: 1},0.25)\n          .fromTo(deks[1],0.08,{yPercent: -50, autoAlpha: 1},{yPercent: -250, autoAlpha: 0},0.75)\n          .fromTo(deks[2],0.08,{yPercent: 200, autoAlpha: 0},{yPercent: -50, autoAlpha: 1},0.75)\n          ;\n      } else {\n        tiles = tiles.querySelector('.rlc-in');\n        const images = tiles.querySelectorAll('.rlc-image'),\n        vC = tiles.querySelector('.rlc-videocontainer');\n        let vid;\n\n        if (vC.classList.contains('video_loaded')) {\n            vid = vC.getElementsByTagName('video');\n        } else {\n            vC.addEventListener(\"VIDEO_LOADED\", function() {\n                vid = vC.getElementsByTagName('video');\n            });\n        }\n\n        let tD = gsap.timeline({\n              defaults: {\n                  ease: \"none\",\n                  duration: 1\n              },\n              scrollTrigger: {\n                  trigger: $element,\n                  start: () => \"top top\",\n                  pin: true,\n                  scrub: 0.1,\n                  anticipatePin: 1,\n                  invalidateOnRefresh: true\n              }\n          })\n          .fromTo(tiles,1,{x: 0},{x: '-41.875em'},0)\n          .fromTo(bgVid,1,{xPercent: 0},{xPercent: -25},0)\n          .fromTo(deks[0],0.08,{autoAlpha: 1},{autoAlpha: 0},0.25)\n          .fromTo(deks[0],0.08,{autoAlpha: 1},{autoAlpha: 0},0.25)\n          .fromTo(deks[1],0.08,{autoAlpha: 0},{autoAlpha: 1},0.25)\n          .fromTo(images[1],0.33,{scale: 1.15},{scale: 1},0.25)\n          .fromTo(vid,0.33,{scale: 1.15},{scale: 1},0.25)\n          .fromTo(vid,0.33,{scale: 1.15},{scale: 1},0.50)\n          .fromTo(images[2],0.33,{scale: 1.15},{scale: 1},0.50)\n          .fromTo(deks[1],0.08,{autoAlpha: 1},{autoAlpha: 0},0.75)\n          .fromTo(deks[2],0.08,{autoAlpha: 0},{autoAlpha: 1},0.75)\n          ;\n      }\n    });\n\n\n    // SCROLL ZOOM '26\n    const scrollZooms = content.querySelectorAll('.rlc-scrollzoom-26');\n    scrollZooms.forEach(function ($element, index) {\n      const el = $element.querySelector('.rlc-imagery');\n      let sZ = gsap.timeline({\n              defaults: {\n                  ease: \"none\",\n                  duration: 1\n              },\n              scrollTrigger: {\n                  trigger: $element,\n                  start: () => \"top bottom\",\n                  end: () => \"center center\",\n                  scrub: 0.1,\n                  anticipatePin: 1,\n                  invalidateOnRefresh: true\n              }\n          })\n          .fromTo(el,0.25,{xPercent: -50,yPercent: -50, scale: 1.15},{xPercent: -50,yPercent: -50, scale: 1},0)\n    });\n\n    const scrollZoomImg = content.querySelectorAll('.rlc-scrollzoom-img');\n    scrollZoomImg.forEach(function ($element, index) {\n      const el = $element.querySelector('.rlc-image');\n      let sI = gsap.timeline({\n              defaults: {\n                  ease: \"none\",\n                  duration: 1\n              },\n              scrollTrigger: {\n                  trigger: $element,\n                  start: () => \"top bottom\",\n                  end: () => \"center center\",\n                  scrub: 0.1,\n                  anticipatePin: 1,\n                  invalidateOnRefresh: true\n              }\n          })\n          .fromTo(el,0.25,{xPercent: -50,yPercent: -50, scale: 1.15},{xPercent: -50,yPercent: -50, scale: 1},0)\n    });\n\n    const scrollZoomVid = content.querySelectorAll('.rlc-scrollzoom-vid');\n    scrollZoomVid.forEach(function ($element, index) {\n        const vC = $element.querySelector('.rlc-videocontainer');\n\n        function zoomVid() {\n            const el = $element.getElementsByTagName('video');\n            let sI = gsap.timeline({\n                    defaults: {\n                        ease: \"none\",\n                        duration: 1\n                    },\n                    scrollTrigger: {\n                        trigger: $element,\n                        start: () => \"top bottom\",\n                        end: () => \"center center\",\n                        scrub: 0.1,\n                        anticipatePin: 1,\n                        invalidateOnRefresh: true\n                    }\n                })\n                .fromTo(el,0.25,{xPercent: -50,yPercent: -50, scale: 1.15},{xPercent: -50,yPercent: -50, scale: 1},0)\n        }\n        if (vC.classList.contains('video_loaded')) {\n            zoomVid()\n        } else {\n            vC.addEventListener(\"VIDEO_LOADED\", zoomVid);\n        }\n    });\n\n    // JUMP LINKS \n    const jumpLinks = content.querySelectorAll('.rlc-jumptile');\n    jumpLinks.forEach(function ($element, index) {\n      const theLink = $element.querySelector('.rlc-hotspot'),\n        target = theLink.getAttribute('href').replace(/#\\b/g, ''),\n        targetEl = document.getElementById(target);\n        theLink.addEventListener('click',function(e){\n          e.preventDefault();\n          let spaceAbove = 0;\n            if (index == 0) {\n                spaceAbove = window.innerHeight;\n            }\n          gsap.to(window, {\n            duration: 1,\n            scrollTo: {\n                y: targetEl,\n                offsetY: spaceAbove\n            }\n          