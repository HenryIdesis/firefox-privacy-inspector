{
  "manifest_version": 3,
  "name": "Firefox Privacy Inspector",
  "version": "0.1.0",
  "description": "Detector e bloqueador de indicadores de rastreamento e violação de privacidade.",
  "permissions": [
    "webRequest",
    "cookies",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "Privacy Inspector",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}